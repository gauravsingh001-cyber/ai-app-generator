generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String          @id @default(uuid())
  email     String          @unique
  password  String
  createdAt DateTime        @default(now())
  records   DynamicRecord[]
}

model AppConfig {
  id        String   @id @default(uuid())
  name      String
  config    Json     // The JSON configuration
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DynamicRecord {
  id        String   @id @default(uuid())
  entity    String   // The name of the entity, e.g., "customers"
  data      Json     // The actual data
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String?  
  user      User?    @relation(fields: [userId], references: [id])

  @@index([entity])
}
